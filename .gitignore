# Secrets
.env
.env.*
!.env.example
*.pem

# Builds and what they need. Builds go in a release, with pch publish, not in the repo.
/dist/
node_modules/

# Screenshots and clips from the test scripts
/shots/

# Editors and systems
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log

# The sounds scripts/sounds.mjs rebuilds from the Sonniss bundles (MISSING_ASSETS.md): their licence bars passing them
# on, so they never go in git. Only the CC0 sounds below are tracked.
/sonniss/
/public/sfx/*.ogg
/public/sfx/*.m4a
